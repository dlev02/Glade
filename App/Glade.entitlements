<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The hardened runtime blocks Location without this. Glade asks only so macOS will
	     tell it the Wi-Fi network's name; it never reads where the Mac is. -->
	<key>com.apple.security.personal-information.location</key>
	<true/>
</dict>
</plist>
